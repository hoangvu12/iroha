{
  "name": "iroha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["ui"],
  "scripts": {
    "dev": "concurrently -n server,ui -c blue,magenta \"bun run dev:server\" \"bun run dev:ui\"",
    "dev:server": "bun --watch src/main.ts",
    "dev:ui": "bun run --cwd ui dev",
    "build": "bun run build:ui",
    "build:ui": "bun run --cwd ui build",
    "start": "bun src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && bun run --cwd ui typecheck",
    "db:generate": "bun run db:generate:sqlite && bun run db:generate:postgres",
    "db:generate:sqlite": "drizzle-kit generate --config=drizzle.sqlite.config.ts",
    "db:generate:postgres": "drizzle-kit generate --config=drizzle.postgres.config.ts"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.11",
    "@elysiajs/static": "^1.4.0",
    "drizzle-orm": "^0.44.7",
    "elysia": "^1.4.11",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.15.6",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.9.3"
  }
}
