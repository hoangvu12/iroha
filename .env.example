# Required: SQLite or PostgreSQL. The file path must be persistent in production.
DATABASE_URL=file:./data/iroha.db

# Required: generate a stable secret, for example with `openssl rand -hex 32`.
# Must be at least 32 characters. The placeholder below is rejected at startup.
IROHA_MASTER_KEY=replace-with-a-stable-random-secret

# Required only until the Owner account has been created. Same length rule.
IROHA_SETUP_TOKEN=replace-with-a-separate-random-secret

# Optional: persistent browser-based password recovery; treat as a root credential.
IROHA_RECOVERY_TOKEN=

# Optional: public Logo.dev publishable token embedded into the management UI
# build. The browser requests img.logo.dev directly and falls back to Google's
# favicon service. Do not use a private secret here.
VITE_LOGO_DEV_TOKEN=

IROHA_SHUTDOWN_GRACE_MS=10000

# Optional server binding.
HOST=0.0.0.0
PORT=3000
